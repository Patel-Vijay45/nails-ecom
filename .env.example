# Database. SQLite file for local use. For production use Postgres
# (change provider in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# Admin panel login (/admin). Change both before going live.
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-a-long-random-string"

# Razorpay (UPI / cards / netbanking). Leave empty to offer only Cash on Delivery.
# Get keys at https://dashboard.razorpay.com -> Settings -> API Keys (use Test Mode first).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Where uploaded product / reference photos are stored on disk.
UPLOAD_DIR="./uploads"

# Your live website address, used in WhatsApp messages (e.g. https://yourshop.in)
SITE_URL="http://localhost:3000"

# Optional: store uploaded photos on Cloudinary instead of the server's disk.
# Needed on hosts whose disk is temporary (Vercel, Netlify, Render/Railway without a volume).
# Free account at https://cloudinary.com → Dashboard → "API environment variable".
CLOUDINARY_URL=""
CLOUDINARY_FOLDER="nails-shop"

# Optional: pincode lookup service used to fill city/state at checkout (free India Post data).
# Leave empty to use https://api.postalpincode.in/pincode/
PINCODE_API_URL=""

# Optional: Shiprocket courier booking (Admin → Shipping). Guide: docs/07-shiprocket-setup.md
# Use an API user (Shiprocket → Settings → API → Create an API user), NOT your normal Shiprocket login.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Any long random text. Enter the same value as the webhook "security token" in Shiprocket → Settings → API → Webhooks.
SHIPROCKET_WEBHOOK_TOKEN=""
# Set to 1 to try courier booking with pretend couriers (no account, nothing charged). Don't use on the live shop.
SHIPROCKET_DEMO=""
